#!/bin/sh
set -eu

export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}"
lock_dir="$cache_dir/chezmoi-update.lock"
source_dir=$(chezmoi source-path)
mkdir -p "$cache_dir"

notify_failure() {
  if [ "$(uname -s)" = Darwin ] && command -v osascript >/dev/null 2>&1; then
    osascript -e 'display notification "See ~/Library/Logs/chezmoi-update.log" with title "chezmoi update failed"' >/dev/null 2>&1 || true
  fi
}

cleanup() {
  status=$?
  trap - EXIT HUP INT TERM
  rm -rf "$lock_dir"
  if [ "$status" -ne 0 ]; then
    notify_failure
  fi
  exit "$status"
}

if ! mkdir "$lock_dir" 2>/dev/null; then
  if [ -f "$lock_dir/pid" ] && kill -0 "$(cat "$lock_dir/pid")" 2>/dev/null; then
    printf 'Another chezmoi update is already running.\n' >&2
    exit 0
  fi
  rm -rf "$lock_dir"
  mkdir "$lock_dir"
fi
printf '%s\n' "$$" >"$lock_dir/pid"
trap cleanup EXIT HUP INT TERM

if [ -n "$(git -C "$source_dir" status --porcelain --untracked-files=normal)" ]; then
  printf 'Refusing to update: chezmoi source is dirty: %s\n' "$source_dir" >&2
  exit 1
fi

chezmoi update --no-tty

skills_stamp="$cache_dir/skills-update.stamp"
if command -v skills >/dev/null 2>&1 && {
  [ ! -f "$skills_stamp" ] || find "$skills_stamp" -mtime +6 -print -quit | grep -q .
}; then
  skills update --global --yes
  touch "$skills_stamp"
fi
