if status is-interactive
    fish_config theme choose "Dracula Official"

    # PATH
    fish_add_path $HOME/.local/bin

    # mise - dev tool version manager
    mise activate fish | source

    # ENV
    {{- if (index . "is_work") }}
    # Claude Code / Vertex AI
    set -gx CLAUDE_CODE_USE_VERTEX 1
    set -gx CLOUD_ML_REGION {{ .vertex_region | quote }}
    set -gx ANTHROPIC_VERTEX_PROJECT_ID {{ .vertex_project_id | quote }}
    {{- end }}

    set EDITOR nvim

    # zoxide - a better cd
    zoxide init fish | source

    {{- if eq .chezmoi.os "darwin" }}
    # Homebrew
    fish_add_path /opt/homebrew/bin /opt/homebrew/sbin
    {{- end }}

    # Aliases
    alias vim nvim
    alias vi nvim
    alias grep rg
    alias g git


    # Starship prompt
    # Starship embeds its own executable path in fish_prompt. Rewrite that path
    # to our stable symlink so existing terminals survive `mise up` upgrades
    # without paying the mise shim startup cost on every prompt.
    set -l starship_bin $HOME/.local/bin/starship
    set -l starship_path_pattern \
        (string escape --style=regex "$HOME/.local/share/mise/installs/aqua-starship-starship/")"[^/]+/starship"
    $starship_bin init fish --print-full-init \
        | string replace --regex --all "$starship_path_pattern" "$starship_bin" \
        | source
end
