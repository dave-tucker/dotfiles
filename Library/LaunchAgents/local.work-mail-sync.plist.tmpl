<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.work-mail-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ .chezmoi.homeDir | html }}/.local/bin/sync-work-mail</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/podman/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>{{ .chezmoi.homeDir | html }}/Library/Logs/work-mail-sync.log</string>
  <key>StandardErrorPath</key>
  <string>{{ .chezmoi.homeDir | html }}/Library/Logs/work-mail-sync.log</string>
</dict>
</plist>
