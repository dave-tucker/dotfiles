#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"

# Re-run when the managed mise manifest or machine role changes.
# machine-role: {{ .machine_role }}
# manifest-sha256: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}

mise bootstrap packages apply --yes
mise install
